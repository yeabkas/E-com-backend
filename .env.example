# Django Environment Configuration
DJANGO_SECRET_KEY=generate-a-secure-random-secret-key-for-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database (Automatically supplied by Render when linking a PostgreSQL database)
# DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# CORS & CSRF (Include your deployed Vercel URL and local development)
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app,https://your-backend.onrender.com

# Frontend URL
FRONTEND_URL=https://your-project.vercel.app

# Public backend URL used for payment provider webhooks
BACKEND_URL=https://your-backend.onrender.com

# On-demand frontend revalidation (Next.js)
# FRONTEND_REVALIDATE_URL=https://your-project.vercel.app/api/revalidate
# FRONTEND_REVALIDATE_SECRET=change-me

# Redis / Celery (Optional - for Celery background tasks)
# REDIS_URL=redis://localhost:6379/1
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Payment & Email (Optional)
# CHAPA_SECRET_KEY=
# CHAPA_WEBHOOK_SECRET=
# ANYMAIL_SENDGRID_API_KEY=
